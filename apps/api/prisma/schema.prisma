generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UnitMeasure {
  g
  ml
  un
}

enum TaxRegime {
  SIMPLES
  LUCRO_PRESUMIDO
  LUCRO_REAL
}

enum TaxConfidence {
  APPROVED
  REVIEW_REQUIRED
  BLOCKED
}

enum FiscalStrategy {
  COMBINED_FOOD_SERVICE
  SPLIT_INGREDIENTS_PREPARATION_FEE
}

enum PaymentMethod {
  PIX
  DINHEIRO
  DEBITO
  CREDITO
  OUTRO
}

enum SaleStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum StockMovementType {
  ENTRADA
  SAIDA
  VENDA
  AJUSTE
  PERDA
  DEVOLUCAO
  INVENTARIO
}

enum StockMovementOrigin {
  SALE
  SALE_CANCELLATION
  PURCHASE
  MANUAL
  INVENTORY
}

enum PurchaseStatus {
  POSTED
  CANCELLED
}

enum PayableStatus {
  OPEN
  PAID
  CANCELED
}

enum FiscalDocumentType {
  NFE
  NFCE
  NFE_DEVOLUCAO
}

enum FiscalDocumentStatus {
  DRAFT
  VALIDATED
  TRANSMISSION_BLOCKED
  QUEUED
  AUTHORIZED
  REJECTED
  CANCELLED
}

enum FiscalEventType {
  TRANSMISSAO
  CANCELAMENTO
  DEVOLUCAO
  CARTA_CORRECAO
  INUTILIZACAO
}

enum FiscalEnvironment {
  HOMOLOGATION
  PRODUCTION
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  ABERTURA
  VENDA
  SANGRIA
  SUPRIMENTO
  FECHAMENTO
}

enum UserRole {
  AURA_ADMIN
  COMPANY_ADMIN
}

enum AuraCustomerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELED
}

enum AuraContractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  CANCELED
  EXPIRED
}

enum AuraPaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

enum AuraPaymentMethod {
  PIX
  CREDIT_CARD
  BOLETO
  BANK_TRANSFER
  CASH
  OTHER
}

model TaxClassification {
  id                              String              @id @default(cuid())
  sourceVersion                   String
  cstIbsCbs                       String
  cstDescription                  String
  cClassTrib                      String              @unique
  cClassName                      String
  cClassDescription               String?
  rateType                        String?
  pRedIbs                         Decimal             @default(0) @db.Decimal(5, 2)
  pRedCbs                         Decimal             @default(0) @db.Decimal(5, 2)
  appliesNfe                      Boolean             @default(true)
  appliesNfce                     Boolean             @default(true)
  appliesNfse                     Boolean             @default(false)
  legalReference                  String?
  effectiveFrom                   DateTime?
  effectiveTo                     DateTime?
  createdAt                       DateTime            @default(now())
  updatedAt                       DateTime            @updatedAt
  ingredients                     Ingredient[]
  productTaxProfiles              ProductTaxProfile[] @relation("ProductTaxClassification")
  preparationFeeTaxProfiles       ProductTaxProfile[] @relation("PreparationFeeTaxClassification")
}

model CompanyProfile {
  id          String    @id @default("main")
  legalName   String
  tradeName   String?
  document    String?   @unique
  taxRegime   TaxRegime @default(SIMPLES)
  uf          String    @default("DF")
  city        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  role          UserRole      @default(COMPANY_ADMIN)
  passwordHash  String
  passwordSalt  String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      AuthSession[]
  stores        Store[]
  stockMovements StockMovement[]
  sales         Sale[]
  purchases     Purchase[]
  cashRegisters CashRegister[]
  cashMovements CashMovement[]
  customerAccount AuraCustomerAccount?
}

model AuthSession {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  userId      String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Store {
  id                 String    @id @default(cuid())
  ownerId            String
  legalName          String
  tradeName          String
  document           String?   @unique
  taxRegime          TaxRegime @default(SIMPLES)
  state              String    @default("DF")
  city               String
  district           String
  addressLine        String
  addressNumber      String
  addressComplement  String?
  zipCode            String?
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  owner              User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products           Product[]
  stockMovements     StockMovement[]
  sales              Sale[]
  cashRegisters      CashRegister[]
  suppliers          Supplier[]
  purchases          Purchase[]
  accountsPayable    AccountPayable[]
  fiscalDocuments    FiscalDocument[]
  fiscalSequences    FiscalSequence[]

  @@index([ownerId])
}

model AuraPlan {
  id            String         @id @default(cuid())
  name          String         @unique
  description   String?
  monthlyPrice  Decimal        @db.Decimal(12, 2)
  setupFee      Decimal        @default(0) @db.Decimal(12, 2)
  maxStores     Int            @default(1)
  features      String?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  contracts     AuraContract[]
}

model AuraCustomerAccount {
  id                  String             @id @default(cuid())
  userId              String             @unique
  legalName           String
  tradeName           String?
  document            String?            @unique
  phone               String?
  taxRegime           TaxRegime          @default(SIMPLES)
  status              AuraCustomerStatus @default(PENDING)
  accessEnabled       Boolean            @default(false)
  contractApprovedAt  DateTime?
  paymentCurrentUntil DateTime?
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contracts           AuraContract[]
  payments            AuraPayment[]
}

model AuraContract {
  id                    String             @id @default(cuid())
  customerId            String
  planId                String
  code                  String             @unique
  status                AuraContractStatus @default(DRAFT)
  startsAt              DateTime
  endsAt                DateTime?
  signedAt              DateTime?
  monthlyPriceSnapshot  Decimal            @db.Decimal(12, 2)
  setupFeeSnapshot      Decimal            @default(0) @db.Decimal(12, 2)
  contractUrl           String?
  notes                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  customer              AuraCustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan                  AuraPlan           @relation(fields: [planId], references: [id])
  payments              AuraPayment[]

  @@index([customerId])
  @@index([planId])
}

model AuraPayment {
  id          String             @id @default(cuid())
  customerId  String
  contractId  String?
  amount      Decimal            @db.Decimal(12, 2)
  dueDate     DateTime
  paidAt      DateTime?
  status      AuraPaymentStatus  @default(PENDING)
  method      AuraPaymentMethod  @default(PIX)
  reference   String?
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  customer    AuraCustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contract    AuraContract?       @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([contractId])
}

model Ingredient {
  id                  String             @id @default(cuid())
  name                String             @unique
  unitMeasure         UnitMeasure
  unitCost            Decimal            @db.Decimal(12, 4)
  stockCurrent        Decimal            @db.Decimal(14, 3)
  ncm                 String
  pisCst              String             @default("06")
  cofinsCst           String             @default("06")
  icmsCst             String?
  icmsCsosn           String?
  taxBenefitCode      String?
  taxConfidence       TaxConfidence      @default(REVIEW_REQUIRED)
  taxNotes            String?
  taxClassificationId String?
  taxClassification   TaxClassification? @relation(fields: [taxClassificationId], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  productIngredients  ProductIngredient[]
  stockMovements      StockMovement[]
  purchaseItems       PurchaseItem[]
}

model Product {
  id                 String          @id @default(cuid())
  storeId            String?
  name               String
  sku                String
  category           String
  salePrice          Decimal         @db.Decimal(12, 2)
  active             Boolean         @default(true)
  preparationFee     Decimal         @default(5.00) @db.Decimal(12, 2)
  fiscalStrategy     FiscalStrategy  @default(SPLIT_INGREDIENTS_PREPARATION_FEE)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  store              Store?          @relation(fields: [storeId], references: [id], onDelete: SetNull)
  ingredients        ProductIngredient[]
  taxProfile         ProductTaxProfile?
  saleItems          SaleItem[]

  @@index([storeId])
  @@unique([storeId, sku])
}

model ProductIngredient {
  id                String     @id @default(cuid())
  productId         String
  ingredientId      String
  qtyUsed           Decimal    @db.Decimal(14, 3)
  unitCostSnapshot  Decimal    @db.Decimal(12, 4)
  totalCostSnapshot Decimal    @db.Decimal(12, 4)
  createdAt         DateTime   @default(now())
  product           Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient        Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([productId, ingredientId])
}

model ProductTaxProfile {
  productId                          String             @id
  uf                                 String             @default("DF")
  taxRegime                          TaxRegime          @default(SIMPLES)
  ncm                                String
  csosn                              String
  pisCst                             String
  cofinsCst                          String
  cstIbsCbs                          String
  cClassTrib                         String
  taxClassificationId                String?
  preparationFeeNcm                  String             @default("21069090")
  preparationFeeCstIbsCbs            String
  preparationFeeCClassTrib           String
  preparationFeeTaxClassificationId  String?
  fiscalStrategy                     FiscalStrategy
  legalBasis                         String?
  requiresLegalReview                Boolean            @default(true)
  createdAt                          DateTime           @default(now())
  updatedAt                          DateTime           @updatedAt
  product                            Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  taxClassification                  TaxClassification? @relation("ProductTaxClassification", fields: [taxClassificationId], references: [id])
  preparationFeeTaxClassification    TaxClassification? @relation("PreparationFeeTaxClassification", fields: [preparationFeeTaxClassificationId], references: [id])
}

model StockMovement {
  id           String              @id @default(cuid())
  storeId      String?
  ingredientId String
  userId       String?
  type         StockMovementType
  origin       StockMovementOrigin
  originId     String?
  quantity     Decimal             @db.Decimal(14, 3)
  unitCost     Decimal?            @db.Decimal(12, 4)
  totalCost    Decimal?            @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime            @default(now())

  store      Store?     @relation(fields: [storeId], references: [id], onDelete: SetNull)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  user       User?      @relation(fields: [userId], references: [id])

  @@index([storeId])
  @@index([ingredientId])
  @@index([createdAt])
}

model Sale {
  id             String      @id @default(cuid())
  storeId        String?
  userId         String?
  cashRegisterId String?
  number         Int
  customerName   String?
  status         SaleStatus  @default(OPEN)
  subtotal       Decimal     @default(0) @db.Decimal(12, 2)
  discount       Decimal     @default(0) @db.Decimal(12, 2)
  total          Decimal     @default(0) @db.Decimal(12, 2)
  totalCost      Decimal     @default(0) @db.Decimal(12, 2)
  openedAt       DateTime    @default(now())
  closedAt       DateTime?
  cancelledAt    DateTime?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  store        Store?        @relation(fields: [storeId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  cashRegister CashRegister? @relation(fields: [cashRegisterId], references: [id], onDelete: SetNull)
  items        SaleItem[]
  payments     Payment[]
  fiscalDocuments FiscalDocument[]

  @@index([storeId])
  @@index([status])
  @@index([openedAt])
  @@unique([storeId, number])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @db.Decimal(12, 2)
  unitCost  Decimal @default(0) @db.Decimal(12, 4)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
}

model Payment {
  id        String        @id @default(cuid())
  saleId    String
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  createdAt DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

model CashRegister {
  id                     String             @id @default(cuid())
  storeId                String?
  userId                 String?
  status                 CashRegisterStatus @default(OPEN)
  openingBalance         Decimal            @default(0) @db.Decimal(12, 2)
  closingBalanceInformed Decimal?           @db.Decimal(12, 2)
  closingBalanceExpected Decimal?           @db.Decimal(12, 2)
  difference             Decimal?           @db.Decimal(12, 2)
  openedAt               DateTime           @default(now())
  closedAt               DateTime?
  notes                  String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  store     Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull)
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  sales     Sale[]
  movements CashMovement[]

  @@index([storeId])
}

model CashMovement {
  id             String           @id @default(cuid())
  cashRegisterId String
  userId         String?
  type           CashMovementType
  amount         Decimal          @db.Decimal(12, 2)
  description    String?
  createdAt      DateTime         @default(now())

  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([cashRegisterId])
}

model Supplier {
  id          String   @id @default(cuid())
  storeId     String?
  name        String
  document    String?
  phone       String?
  email       String?
  contactName String?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store           Store?           @relation(fields: [storeId], references: [id], onDelete: SetNull)
  purchases       Purchase[]
  accountsPayable AccountPayable[]

  @@index([storeId])
  @@unique([storeId, document])
}

model Purchase {
  id         String         @id @default(cuid())
  storeId    String?
  supplierId String?
  userId     String?
  number     Int
  status     PurchaseStatus @default(POSTED)
  issueDate  DateTime       @default(now())
  total      Decimal        @default(0) @db.Decimal(12, 2)
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  store           Store?           @relation(fields: [storeId], references: [id], onDelete: SetNull)
  supplier        Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  items           PurchaseItem[]
  accountsPayable AccountPayable[]
  fiscalDocuments FiscalDocument[]

  @@index([storeId])
  @@index([supplierId])
  @@index([issueDate])
  @@unique([storeId, number])
}

model PurchaseItem {
  id               String  @id @default(cuid())
  purchaseId       String
  ingredientId     String
  quantity         Decimal @db.Decimal(14, 3)
  unitCost         Decimal @db.Decimal(12, 4)
  totalCost        Decimal @db.Decimal(12, 2)
  previousStock    Decimal @db.Decimal(14, 3)
  previousUnitCost Decimal @db.Decimal(12, 4)
  newStock         Decimal @db.Decimal(14, 3)
  newUnitCost      Decimal @db.Decimal(12, 4)

  purchase   Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([purchaseId])
  @@index([ingredientId])
}

model AccountPayable {
  id          String        @id @default(cuid())
  storeId     String?
  supplierId  String?
  purchaseId  String?
  description String
  amount      Decimal       @db.Decimal(12, 2)
  dueDate     DateTime
  paidAt      DateTime?
  status      PayableStatus @default(OPEN)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  store    Store?    @relation(fields: [storeId], references: [id], onDelete: SetNull)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([supplierId])
  @@index([purchaseId])
  @@index([dueDate])
  @@index([status])
}

model FiscalSequence {
  id           String              @id @default(cuid())
  storeId      String
  documentType FiscalDocumentType
  environment  FiscalEnvironment   @default(HOMOLOGATION)
  series       String              @default("1")
  currentNumber Int                @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, documentType, environment, series])
  @@index([storeId])
}

model FiscalDocument {
  id              String               @id @default(cuid())
  storeId         String
  saleId          String?
  purchaseId      String?
  type            FiscalDocumentType
  environment     FiscalEnvironment    @default(HOMOLOGATION)
  status          FiscalDocumentStatus @default(DRAFT)
  series          String               @default("1")
  number          Int
  accessKey       String?
  protocol        String?
  rejectionReason String?
  payload         Json
  xml             String?
  xmlSha256       String?
  issuedAt        DateTime?
  authorizedAt    DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sale     Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)
  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  events   FiscalDocumentEvent[]

  @@unique([storeId, type, environment, series, number])
  @@index([storeId])
  @@index([saleId])
  @@index([purchaseId])
  @@index([status])
  @@index([createdAt])
}

model FiscalDocumentEvent {
  id         String               @id @default(cuid())
  documentId String
  type       FiscalEventType
  status     FiscalDocumentStatus @default(DRAFT)
  reason     String?
  protocol   String?
  payload    Json?
  response   Json?
  createdAt  DateTime             @default(now())

  document FiscalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([type])
  @@index([createdAt])
}
